<shader name="final_composite" version="440 core" base="meteor_assets/shader_base/standard_shader.glsl">
    <properties>
    </properties>

    #VERTEX_PASS

    void meteorVertexPass(inout vec3 vertexPosition, inout vec3 vertexNormal, inout vec2 vertexTexCoords)
    {
        // NDC quad, identity matrices - applyProjection() passes through unchanged.
    }

    #END_VERTEX_PASS

    #FRAGMENT_PASS

    uniform sampler2D _albedoTex;  // BUFFER_OPAQUE  (GL_RGBA16F, linear, unit 0)
    uniform sampler2D _lightsTex;  // BUFFER_LIGHTS  (GL_RGBA16F, linear, unit 1)
    uniform int       _useLights;  // 0 = opaque only (no lighting stage ran)

    // Exact sRGB encode (IEC 61966-2-1). The only linear -> display
    // conversion in the pipeline; everything upstream is linear.
    vec3 linearToSrgb(vec3 c)
    {
        c = clamp(c, 0.0, 1.0);
        vec3 lo = c * 12.92;
        vec3 hi = 1.055 * pow(c, vec3(1.0 / 2.4)) - 0.055;
        return mix(hi, lo, vec3(lessThanEqual(c, vec3(0.0031308))));
    }

    vec4 meteorFragmentPass(vec3 v2fPosition, vec3 v2fNormal, vec2 v2fTexCoords)
    {
        vec4 opaque = texture(_albedoTex, v2fTexCoords);
        vec4 light  = _useLights != 0 ? texture(_lightsTex, v2fTexCoords) : vec4(0.0);

        // Light mask compositing:
        //   light.a = 0 → unlit pixel, pass through opaque as-is
        //   light.a = 1 → lit pixel, multiply opaque by light contribution
        vec3 result = mix(opaque.rgb, opaque.rgb * light.rgb, light.a);

        return vec4(linearToSrgb(result), opaque.a);
    }

    #END_FRAGMENT_PASS

</shader>
