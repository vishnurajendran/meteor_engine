<shader name="prepass" version="440 core" base="meteor_assets/shader_base/standard_shader.glsl">
    <properties>
    </properties>

    #VERTEX_PASS

    void meteorVertexPass(inout vec3 vertexPosition, inout vec3 vertexNormal, inout vec2 vertexTexCoords)
    {
        // No modifications. gl_Position is declared invariant in the shared
        // projection utils, so depth written here matches the opaque pass
        // exactly and its GL_LEQUAL test passes.
    }

    #END_VERTEX_PASS

    #FRAGMENT_PASS

    // ---- Outputs --------------------------------------------------------------
    // Output 0 (FragColor, the returned value) -> BUFFER_NORMAL  (RGBA16F)
    //     rgb = view-space normal, normal map applied; a = 1 (geometry drawn)
    // Output 1 (outSurface)                    -> BUFFER_SURFACE (RGBA8)
    //     r = metallic, g = smoothness, b = 1 lit / 0 unlit, a = 1 (drawn)
    // Depth is written to BUFFER_DEPTH by the hardware.
    layout(location = 1) out vec4 outSurface;

    // ---- Material inputs (forwarded per item by MPrepassStage) ---------------
    uniform sampler2D _normalMap;
    uniform int       _useNormalMap;
    uniform float     _metallic;
    uniform float     _smoothness;
    uniform int       _lit;          // material shading mode, 1 = Lit

    // ---- Screen-space derivative TBN ----------------------------------------
    // Reconstructs a tangent frame from world-position and UV derivatives
    // without needing per-vertex tangent attributes. Lower fidelity at
    // grazing angles and UV seams than MikkTSpace tangents.
    vec3 perturbNormal(vec3 worldPos, vec3 N, vec2 uv)
    {
        vec3 mapN = texture(_normalMap, uv).rgb * 2.0 - 1.0;

        vec3 dp1  = dFdx(worldPos);
        vec3 dp2  = dFdy(worldPos);
        vec2 duv1 = dFdx(uv);
        vec2 duv2 = dFdy(uv);

        vec3 dp2perp = cross(dp2, N);
        vec3 dp1perp = cross(N, dp1);

        vec3 T = dp2perp * duv1.x + dp1perp * duv2.x;
        vec3 B = dp2perp * duv1.y + dp1perp * duv2.y;

        float invmax = inversesqrt(max(dot(T, T), dot(B, B)));
        mat3  TBN    = mat3(T * invmax, B * invmax, N);

        return normalize(TBN * mapN);
    }

    vec4 meteorFragmentPass(vec3 v2fPosition, vec3 v2fNormal, vec2 v2fTexCoords)
    {
        vec3 worldPos = getVertexPositionWorld();
        vec3 N        = normalize(getVertexNormalWorld());

        if (_useNormalMap == 1)
            N = perturbNormal(worldPos, N, v2fTexCoords);

        vec3 viewNormal = normalize(mat3(view) * N);

        outSurface = vec4(clamp(_metallic,   0.0, 1.0),
                          clamp(_smoothness, 0.0, 1.0),
                          float(_lit),
                          1.0);

        return vec4(viewNormal, 1.0);
    }

    #END_FRAGMENT_PASS

</shader>
