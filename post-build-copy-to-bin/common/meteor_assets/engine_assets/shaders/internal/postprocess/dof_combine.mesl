<shader name="pp_dof_combine" version="440 core" base="meteor_assets/shader_base/standard_shader.glsl">
    <properties>
    </properties>

    #VERTEX_PASS
    // Fullscreen quad, already in NDC; model/view/projection are identity.
    void meteorVertexPass(inout vec3 vertexPosition, inout vec3 vertexNormal, inout vec2 vertexTexCoords) {}
    #END_VERTEX_PASS

    #FRAGMENT_PASS

    uniform sampler2D _source;   // full-res HDR scene (sharp)
    uniform sampler2D _coc;      // full-res CoC, half-res pixels
    uniform sampler2D _dof;      // half-res blurred result, a = foreground amount
    uniform int       _showFocus;   // debug: tint near (orange) / far (blue)
    uniform float     _bokehRadius; // max CoC, for the debug tint strength

    vec4 meteorFragmentPass(vec3 v2fPosition, vec3 v2fNormal, vec2 v2fTexCoords)
    {
        vec2  uv     = v2fTexCoords;
        vec3  sharp  = texelFetch(_source, ivec2(gl_FragCoord.xy), 0).rgb;
        float coc    = texture(_coc, uv).r;
        vec4  blurry = texture(_dof, uv);

        // In focus (|CoC| under a pixel) stays the sharp full-res image.
        // Blurry foreground (a) is laid over regardless, so its soft edge
        // reaches over sharp pixels behind it.
        float amount = smoothstep(0.1, 1.0, abs(coc));
        amount = amount + blurry.a - amount * blurry.a;

        vec3 color = mix(sharp, blurry.rgb, amount);

        // Show Focus: in-focus stays as-is; in front of the focus band turns
        // orange, behind it blue, stronger with more blur.
        if (_showFocus != 0)
        {
            float t    = clamp(abs(coc) / max(_bokehRadius, 1e-3), 0.0, 1.0);
            vec3  tint = coc < 0.0 ? vec3(1.0, 0.45, 0.1) : vec3(0.15, 0.4, 1.0);
            float lum  = dot(sharp, vec3(0.2126, 0.7152, 0.0722));
            color = mix(sharp, tint * (0.25 + lum), t * 0.85);
        }

        return vec4(color, 1.0);
    }

    #END_FRAGMENT_PASS

</shader>
