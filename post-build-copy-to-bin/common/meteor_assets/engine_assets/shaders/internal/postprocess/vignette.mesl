<shader name="pp_vignette" version="440 core" base="meteor_assets/shader_base/standard_shader.glsl">
    <properties>
    </properties>

    #VERTEX_PASS
    // Fullscreen quad, already in NDC; model/view/projection are identity.
    void meteorVertexPass(inout vec3 vertexPosition, inout vec3 vertexNormal, inout vec2 vertexTexCoords) {}
    #END_VERTEX_PASS

    #FRAGMENT_PASS

    uniform sampler2D _source;
    uniform float     _intensity;    // 0..1
    uniform float     _smoothness;   // 0..1

    vec4 meteorFragmentPass(vec3 v2fPosition, vec3 v2fNormal, vec2 v2fTexCoords)
    {
        ivec2 pixel = ivec2(gl_FragCoord.xy);
        vec2  size  = vec2(textureSize(_source, 0));
        vec3  color = texelFetch(_source, pixel, 0).rgb;

        // 0 at the centre, 1 in the corners, round regardless of aspect.
        vec2  uv     = gl_FragCoord.xy / size;
        vec2  aspect = vec2(size.x / size.y, 1.0);
        float d      = length((uv - 0.5) * aspect) / length(0.5 * aspect);

        float edge  = smoothstep(1.0 - max(_smoothness, 0.001), 1.0, d);
        color      *= 1.0 - _intensity * edge;

        return vec4(color, 1.0);
    }

    #END_FRAGMENT_PASS

</shader>
