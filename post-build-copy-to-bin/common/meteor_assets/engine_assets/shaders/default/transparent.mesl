<shader name="standard_transparent" version="440 core" base="meteor_assets/shader_base/standard_shader.glsl">
    <properties>
        <property key="_useAlbedoTex"       type="bool"     default="False"/>
        <property key="_albedo"             type="tex2d"    default=""/>
        <property key="_color"              type="color"    default="(1,1,1,0.5)"/>

        <property key="_normalMap"          type="tex2d"    default=""/>
        <property key="_useNormalMap"       type="bool"     default="False"/>

        <property key="_metallic"           type="float"    default="0.0"/>
        <property key="_smoothness"         type="float"    default="0.8"/>

        <property key="_useEmission"        type="bool"     default="False"/>
        <property key="_emissionTex"        type="tex2d"    default=""/>
        <property key="_emissionColor"      type="color"    default="(1,1,1,1)"/>
        <property key="_emissionIntensity"  type="float"    default="1.0"/>
    </properties>

    #VERTEX_PASS

    void meteorVertexPass(inout vec3 vertexPosition, inout vec3 vertexNormal, inout vec2 vertexTexCoords)
    {
        // Standard transform, no vertex deformation.
    }

    #END_VERTEX_PASS

    #FRAGMENT_PASS

    // Standard transparent shader. Use with a material whose Render Mode is
    // Transparent. Drawn by MTransparentStage: sorted back to front, lit per
    // pixel here (forward), then blended over the lit scene in BUFFER_SCENE.
    // Alpha comes from _color.a (times the albedo texture's alpha).

    // ---- Material properties --------------------------------------------------
    uniform sampler2D _albedo;
    uniform int       _useAlbedoTex;
    uniform vec4      _color;

    uniform sampler2D _normalMap;
    uniform int       _useNormalMap;

    uniform float     _metallic;
    uniform float     _smoothness;

    uniform int       _useEmission;
    uniform sampler2D _emissionTex;
    uniform vec4      _emissionColor;
    uniform float     _emissionIntensity;

    // ---- Set by MTransparentStage ----------------------------------------------
    uniform int       _lit;          // material shading mode, 1 = Lit
    uniform vec3      _cameraPos;    // world space

    // Screen-space derivative TBN (same as prepass.mesl).
    vec3 perturbNormal(vec3 worldPos, vec3 N, vec2 uv)
    {
        vec3 mapN = texture(_normalMap, uv).rgb * 2.0 - 1.0;

        vec3 dp1  = dFdx(worldPos);
        vec3 dp2  = dFdy(worldPos);
        vec2 duv1 = dFdx(uv);
        vec2 duv2 = dFdy(uv);

        vec3 dp2perp = cross(dp2, N);
        vec3 dp1perp = cross(N, dp1);

        vec3 T = dp2perp * duv1.x + dp1perp * duv2.x;
        vec3 B = dp2perp * duv1.y + dp1perp * duv2.y;

        float invmax = inversesqrt(max(dot(T, T), dot(B, B)));
        mat3  TBN    = mat3(T * invmax, B * invmax, N);

        return normalize(TBN * mapN);
    }

    vec4 meteorFragmentPass(vec3 v2fPosition, vec3 v2fNormal, vec2 v2fTexCoords)
    {
        // -- Albedo + alpha --
        vec4 albedo = _color;
        if (_useAlbedoTex == 1)
            albedo *= texture(_albedo, v2fTexCoords);

        vec3 color = albedo.rgb;

        // -- Lighting (forward, shared maths with the deferred pass) --
        if (_lit == 1)
        {
            vec3 worldPos = getVertexPositionWorld();
            vec3 N        = normalize(getVertexNormalWorld());
            if (!gl_FrontFacing) N = -N;            // double-sided back faces

            if (_useNormalMap == 1)
                N = perturbNormal(worldPos, N, v2fTexCoords);

            color *= meteorSurfaceLighting(worldPos, N, _cameraPos, _metallic, _smoothness);
        }

        // -- Emission (after lighting, so it glows in the dark) --
        if (_useEmission == 1)
            color += texture(_emissionTex, v2fTexCoords).rgb
                     * _emissionColor.rgb * _emissionIntensity;

        // Linear, not encoded - blended into BUFFER_SCENE (HDR).
        return vec4(color, albedo.a);
    }

    #END_FRAGMENT_PASS

</shader>
